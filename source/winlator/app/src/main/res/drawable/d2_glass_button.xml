<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#5578D8F0">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape android:shape="rectangle">
                    <solid android:color="#66111D2A" />
                    <stroke android:width="1dp" android:color="#335E8298" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#E0182B3D" android:endColor="#E00A1420" />
                    <stroke android:width="1.5dp" android:color="#AA4D839B" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>